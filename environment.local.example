# Api Business Suite (backend)
NEXT_PUBLIC_API_URL=http://localhost:2000
# Producción: https://api-v1-suite.sistemasjaihom.com

# WebSocket / Socket.IO (misma base que la API en producción)
NEXT_PUBLIC_WEBSOCKET_URL=
# Producción: https://api-v1-suite.sistemasjaihom.com

# Session Gateway — chat de prueba CSE (guest)
NEXT_PUBLIC_SESSION_GATEWAY_URL=http://localhost:2012

# API Generic — chat de prueba CSE por organización (Suite)
NEXT_PUBLIC_API_GENERIC_URL=http://localhost:2010

# Firebase (agrega tus variables de Firebase)
# NEXT_PUBLIC_FIREBASE_API_KEY=...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=...
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
# NEXT_PUBLIC_FIREBASE_APP_ID=...

NEXT_PUBLIC_ENV=development
